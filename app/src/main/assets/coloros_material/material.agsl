uniform shader uBitmap; layout(color) uniform vec4 uBgLum; layout(color) uniform vec4 uBgOverlay; layout(color) uniform vec4 uFgLum; layout(color) uniform vec4 uFgOverlay; uniform float uActive;
vec3 luminosity( vec3 s, vec3 d ) {
    float dLum = dot(d, vec3(0.3, 0.59, 0.11));
    float sLum = dot(s, vec3(0.3, 0.59, 0.11));
    float lum = sLum - dLum;
    vec3 c = d + lum;
    float minC = min(min(c.x, c.y), c.z);
    float maxC = max(max(c.x, c.y), c.z);
    if(minC < 0.0) return sLum + ((c - sLum) * sLum) / (sLum - minC);
    else if(maxC > 1.0) return sLum + ((c - sLum) * (1.0 - sLum)) / (maxC - sLum);
    else return c;
}
float overlay(float s, float d) {
    return (d < 0.5) ? 2.0 * s * d : 1.0 - 2.0 * (1.0 - s) * (1.0 - d);
}
vec3 overlay(vec3 s, vec3 d) {
    vec3 c;c.x = overlay(s.x,d.x);c.y = overlay(s.y,d.y);c.z = overlay(s.z,d.z);return c;
}
vec4 colorDodgeBlend(vec4 src, vec4 dst) {
    float alpha_out = src.a + dst.a - src.a * dst.a;
    vec3 color_out = vec3(0.0);
    for (int i = 0; i < 3; i++) {
        if (dst[i] == 0.0) {
            color_out[i] = src[i] * (1.0 - dst.a);
        } else {
            float c = abs(src.a - src[i]);
            if (c == 0.0) {
                color_out[i] = src.a * dst.a + src[i] * (1.0 - dst.a) + dst[i] * (1.0 - src.a);
            } else {
                c = min(dst.a, (dst[i] * src.a) / (c + 0.00000001));
                color_out[i] = (c * src.a + src[i] * (1.0 - dst.a)) + dst[i] * (1.0 - src.a);
            }
        }
    }
    return vec4(color_out, alpha_out);
}
vec4 main(vec2 p) {
 vec4 col = uBitmap.eval(p);
 col.xyz = mix(col.xyz, luminosity(uBgLum.xyz, col.xyz), uBgLum.w);
 col.xyz = mix(col.xyz, overlay(uBgOverlay.xyz, col.xyz), uBgOverlay.w);
 col.xyz = mix(col.xyz, luminosity(uFgLum.xyz, col.xyz), uFgLum.w);
 if (uActive > 0.5) col = colorDodgeBlend(uFgOverlay, col);
 else col.xyz = mix(col.xyz, overlay(uFgOverlay.xyz, col.xyz), uFgOverlay.w);
 return col;
}
