<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Fluix 控件的触摸反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Complete background icon index, including installed packages without Launcher activities. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <permission android:name="dev.rikumi.flymemod.permission.CONTROL_GOOGLE_SERVICE"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.rikumi.flymemod.permission.CONTROL_GOOGLE_SERVICE" />

    <permission android:name="dev.rikumi.flymemod.permission.CONTROL_NETWORK_TILES"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.rikumi.flymemod.permission.CONTROL_NETWORK_TILES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.android.systemui" />
        <package android:name="com.flyme.systemuieditor" />
        <package android:name="com.android.settings" />
        <package android:name="com.meizu.mstore" />
        <package android:name="com.meizu.flyme.weather" />
        <package android:name="com.android.packageinstaller" />
        <package android:name="com.meizu.flyme.launcher" />
        <package android:name="com.meizu.media.camera" />
        <package android:name="com.meizu.media.gallery" />
        <package android:name="com.meizu.flyme.sdkstage" />
        <!-- Recommended scope visibility -->
        <package android:name="com.android.alarmclock" />
        <package android:name="com.android.calendar" />
        <package android:name="com.android.dialer" />
        <package android:name="com.android.email" />
        <package android:name="com.android.incallui" />
        <package android:name="com.android.intentresolver" />
        <package android:name="com.android.mms" />
        <package android:name="com.android.permissioncontroller" />
        <package android:name="com.android.phone" />
        <package android:name="com.android.soundrecorder" />
        <package android:name="com.flyme.meizu.store" />
        <package android:name="com.flyme.sceneengine" />
        <package android:name="com.meizu.account" />
        <package android:name="com.meizu.battery" />
        <package android:name="com.meizu.callsetting" />
        <package android:name="com.meizu.connectivitysettings" />
        <package android:name="com.meizu.customizecenter" />
        <package android:name="com.meizu.filemanager" />
        <package android:name="com.meizu.flyme.calculator" />
        <package android:name="com.meizu.flyme.find" />
        <package android:name="com.meizu.flyme.toolbox" />
        <package android:name="com.meizu.mznfcpay" />
        <package android:name="com.meizu.net.pedometer" />
        <package android:name="com.meizu.notepaper" />
        <package android:name="com.meizu.picker" />
        <package android:name="com.meizu.safe" />
        <package android:name="com.meizu.voiceassistant" />
        <package android:name="com.meizu.wear" />
        <!-- End recommended scope visibility -->
    </queries>

    <application
        android:name=".CameraSettingsBridge"
        android:directBootAware="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        tools:ignore="MissingApplicationIcon">

        <service
            android:name=".GoogleServiceTileService"
            android:exported="true"
            android:icon="@drawable/ic_google_service_tile"
            android:label="@string/google_service_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

        <service android:name=".NetworkTileService$Wifi"
            android:exported="true" android:icon="@drawable/ic_control_wifi"
            android:label="@string/network_tile_wifi"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".NetworkTileService$Bluetooth"
            android:exported="true" android:icon="@drawable/ic_control_bluetooth"
            android:label="@string/network_tile_bluetooth"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".NetworkTileService$Mobile"
            android:exported="true" android:icon="@drawable/ic_control_mobile"
            android:label="@string/network_tile_mobile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <service android:name=".NetworkTileService$DataSim"
            android:exported="true" android:icon="@drawable/ic_network_sim"
            android:label="@string/network_tile_sim"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
        <activity android:name=".NetworkTileSettingsActivity" android:exported="true"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name=".SettingsProvider"
            android:authorities="dev.rikumi.flymemod.settings"
            android:directBootAware="true"
            android:exported="true" />

        <provider
            android:name=".SystemIconPackProvider"
            android:authorities="dev.rikumi.flymemod.icons"
            android:exported="true" />
        <receiver android:name=".SystemIconPackPackages" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_CHANGED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
            <intent-filter><action android:name="android.intent.action.USER_UNLOCKED" /></intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FlymeMod">
            <!-- 在 LSPosed 管理器中提供模块设置入口。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 普通桌面启动入口。 -->
        <activity-alias
            android:name=".MainActivityLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

    <!-- libxposed module configuration is under META-INF/xposed. -->
</manifest>
